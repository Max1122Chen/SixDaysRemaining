<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
   六日英雄 WebGL  IIS 托管配置（Brotli 预压缩版）
   用法：把本文件放在网站根目录，也就是 index.html 所在的那一层。

   原理
   ====
   构建产物是 WebGL.data.br / WebGL.wasm.br / WebGL.framework.js.br，
   而 Unity 的加载器请求的是不带 .br 的名字，所以需要：
     1) 入站重写：把 WebGL.data 之类改写到 WebGL.data.br；
     2) 出站规则：给 .br 响应补 Content-Encoding: br；
     3) 出站规则：把 Content-Type 改回“原始扩展名”对应的类型。
        否则 framework.js.br 会以 application/octet-stream 返回，
        被浏览器的 nosniff 策略拒绝执行。

   前置条件（缺一不可）
   ==================
   1) 安装 IIS 的 URL Rewrite 模块。没装的话 <rewrite> 段会让站点直接报 500.19。
   2) 在服务器级 applicationHost.config 的 <system.webServer><rewrite> 下加入：
          <allowedServerVariables>
            <add name="RESPONSE_Content-Encoding" />
            <add name="RESPONSE_Content-Type" />
          </allowedServerVariables>
      否则出站规则会被忽略（web.config 里改不了这个服务器级设置）。
   3) 本文件关闭了 IIS 自带的静态/动态压缩：Build/*.br 已经是压缩产物。

   如果不想折腾 URL Rewrite
   ======================
   更省事的做法是把 Unity 的 Player Settings  Publishing Settings 
   Compression Format 改成 Disabled，然后删掉本文件里的整个 <rewrite> 段，
   改用它注释掉的备用配置，由 IIS 在传输时压缩。
  ============================================================================
-->
<configuration>
  <system.webServer>

    <staticContent>
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <remove fileExtension=".data" />
      <mimeMap fileExtension=".data" mimeType="application/octet-stream" />
      <remove fileExtension=".mem" />
      <mimeMap fileExtension=".mem" mimeType="application/octet-stream" />
      <remove fileExtension=".br" />
      <mimeMap fileExtension=".br" mimeType="application/octet-stream" />
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="application/javascript" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".mp4" />
      <mimeMap fileExtension=".mp4" mimeType="video/mp4" />
      <remove fileExtension=".webm" />
      <mimeMap fileExtension=".webm" mimeType="video/webm" />
    </staticContent>

    <urlCompression doStaticCompression="false" doDynamicCompression="false" />

    <rewrite>
      <rules>
        <rule name="UnityWebGL-Brotli-Rewrite" stopProcessing="true">
          <match url="^(.*?\.(?:js|wasm|data|mem|symbols\.json))$" />
          <conditions>
            <add input="{REQUEST_FILENAME}.br" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}.br" />
        </rule>
      </rules>

      <outboundRules>
        <rule name="UnityWebGL-Brotli-Encoding" preCondition="IsBrotli">
          <match serverVariable="RESPONSE_Content-Encoding" pattern=".*" />
          <action type="Rewrite" value="br" />
        </rule>
        <rule name="UnityWebGL-Brotli-Type-JS" preCondition="IsBrotliJs">
          <match serverVariable="RESPONSE_Content-Type" pattern=".*" />
          <action type="Rewrite" value="application/javascript" />
        </rule>
        <rule name="UnityWebGL-Brotli-Type-WASM" preCondition="IsBrotliWasm">
          <match serverVariable="RESPONSE_Content-Type" pattern=".*" />
          <action type="Rewrite" value="application/wasm" />
        </rule>

        <preConditions>
          <preCondition name="IsBrotli">
            <add input="{REQUEST_FILENAME}" pattern="\.br$" />
          </preCondition>
          <preCondition name="IsBrotliJs">
            <add input="{REQUEST_FILENAME}" pattern="\.js\.br$" />
          </preCondition>
          <preCondition name="IsBrotliWasm">
            <add input="{REQUEST_FILENAME}" pattern="\.wasm\.br$" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>

    <!--
      备用配置：把 Unity 的 Compression Format 改成 Disabled 之后，
      删掉上面的整个 <rewrite> 段，改用下面这两段（不需要 URL Rewrite 模块）。
      <urlCompression doStaticCompression="true" doDynamicCompression="true" />
      <httpCompression>
        <dynamicTypes>
          <add mimeType="application/wasm" enabled="true" />
          <add mimeType="application/octet-stream" enabled="true" />
          <add mimeType="application/javascript" enabled="true" />
          <add mimeType="application/json" enabled="true" />
        </dynamicTypes>
      </httpCompression>
    -->

  </system.webServer>
</configuration>